{
  "name": "journalducuistot",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms dev",
    "cms:clone:prod": "pnpm --filter cms clone:prod",
    "dev": "alchemy dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:cms": "pnpm --filter cms build",
    "test": "pnpm --filter cms test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:alchemy": "tsc -p tsconfig.alchemy.json",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "fmt": "pnpm -r fmt",
    "fmt:check": "pnpm -r fmt:check",
    "postinstall": "pnpm -r postinstall",
    "alchemy": "alchemy",
    "deploy": "NODE_OPTIONS=--max-old-space-size=8192 pnpm alchemy deploy",
    "deploy:github": "NODE_OPTIONS=--max-old-space-size=8192 pnpm alchemy deploy stacks/github.ts --profile admin",
    "deploy:plan": "pnpm alchemy plan",
    "dev:infra": "pnpm alchemy dev",
    "login:alchemy": "pnpm alchemy profile edit",
    "bootstrap:alchemy": "pnpm alchemy provider cloudflare bootstrap",
    "state:alchemy:logs": "pnpm alchemy provider cloudflare state logs"
  },
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@distilled.cloud/nuxt": "^0.17.1",
    "@effect/platform-node": "catalog:",
    "@effect/sql-mysql2": "4.0.1",
    "@effect/sql-pg": "4.0.1",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "nuxt": "catalog:"
  }
}
